# Dependencias de primer nivel de jpltag. El archivo que de verdad se
# instala es requirements.txt (generado de este con pip-compile
# --generate-hashes --strip-extras, mismo comando que usa Soporte
# Existencias, la app hermana ya publicada en maiproject.cl). Para
# regenerarlo tras cambiar una versión acá:
#
#   pip-compile --generate-hashes --strip-extras --output-file=requirements.txt requirements.in
#   pip-audit -r requirements.txt
#
# Versiones probadas y funcionando en este repo (ver commits de Fase 1).
#
# CSP: no se usa el paquete django-csp — Django 6.1 trae su propio
# middleware de Content-Security-Policy (ver config/settings.py).
Django==6.1.1
# python:3.13-slim (base del Dockerfile) no trae el paquete de sistema
# tzdata, y la imagen no instala nada por apt — sin esto, USE_TZ=True con
# TIME_ZONE="America/Santiago" fallaría al primer uso con
# ZoneInfoNotFoundError. Verificado en este repo simulando un contenedor
# sin tzdata del sistema (zoneinfo.reset_tzpath(to=())): con este paquete
# de pip, zoneinfo resuelve la zona igual.
tzdata==2026.5
gunicorn==26.2.0
psycopg[binary]==3.2.3
django-environ==0.14.0
django-axes==8.3.1
whitenoise==6.8.2
python-docx==1.2.0
openpyxl==3.1.5
pandas==3.0.5
sentry-sdk==2.18.0
# Los ImageField de Juzgado (logo, sello_judicial, firma — ver
# nucleo/models.py) necesitan Pillow para que Django valide y procese
# imágenes; sin esto, migrate falla al revisar esos campos. Se escapó
# de requirements.in porque en el entorno de desarrollo Pillow ya
# estaba instalado por otra vía, y manage.py test pasa igual con cache
# en memoria — solo se notó al construir la imagen de verdad con
# JPLTAG_PRUEBAS, que instala estrictamente lo que dice este archivo.
Pillow==12.3.0
# django.core.cache.backends.redis.RedisCache (ver config/settings.py,
# se activa cuando hay VALKEY_URL) necesita este paquete para conectarse
# — Valkey habla el protocolo de Redis, así que redis-py funciona igual.
# Sin él, cualquier intento de iniciar sesión en el servidor habría
# fallado (CACHES solo cae a LocMemCache cuando VALKEY_URL está vacía,
# que nunca es el caso ahí). No se detectaba en manage.py test porque,
# sin VALKEY_URL, las pruebas usan la caché en memoria.
redis==8.1.0
# Módulo 1 (plantilla Word editable por Juzgado, ver motor/plantilla.py):
# docxtpl rellena marcadores {{ }} en un .docx usando Jinja2 — así el
# Juzgado diseña su propia carta en Word en vez de que el layout esté
# escrito a mano en motor/cartas.py. Licencia LGPL-2.1 (se usa como
# librería, sin modificar ni redistribuir su código fuente — no aplica
# el copyleft a este repo).
docxtpl==0.20.2
# Cada carta (una patente) se renderiza por separado con docxtpl y
# docxcompose las une en 1 solo .docx (un lote), con un salto de página
# entre cada una — equivalente a lo que antes hacía doc.add_page_break()
# a mano. Licencia MIT.
docxcompose==2.2.0
