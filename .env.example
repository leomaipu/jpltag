# Copiar como ".env" y completar con los valores reales (nunca subir el
# ".env" real al repositorio — ver .gitignore). En el servidor, este archivo
# lo genera "sudo maipu-nueva-bd jpltag" según el informe de implementación.

DJANGO_SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=jpltag.maiproject.cl,localhost,127.0.0.1

# Los entrega "maipu-nueva-bd jpltag" en el servidor (PgBouncer en medio):
DATABASE_URL=postgres://jpltag:CAMBIAR@maipu-pgbouncer:6432/jpltag
VALKEY_URL=redis://:CAMBIAR@maipu-valkey:6379/0

# Opcional: API key de la CMF para la UTM (o CMF_API_KEY_FILE con la ruta de un
# archivo que la contenga); vacío usa mindicador.cl
CMF_API_KEY=

# Opcional: deja vacío para desactivar el reporte de errores a GlitchTip
GLITCHTIP_DSN=

# Máximo de cartas por archivo Word (ver config/settings.py).
# JPLTAG_MAX_CARTAS_POR_ARCHIVO=50
# Paquetes que el worker arma a la vez (1). Subirlo pide más memoria y núcleos
# para el worker: ver DESPLIEGUE.md.
# JPLTAG_PAQUETES_EN_PARALELO=1
# Ofrece «También en PDF» al generar (el worker necesita 1,5 GB o más).
# JPLTAG_PDF_ACTIVO=True
# Solo para desarrollo con runserver, sin el worker: genera dentro de la petición.
# JPLTAG_GENERAR_EN_LA_PETICION=True
