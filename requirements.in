# Dependencias de primer nivel de jpltag. El archivo que de verdad se
# instala es requirements.txt (generado de este con pip-compile
# --generate-hashes --strip-extras, mismo comando que usa Soporte
# Existencias, la app hermana ya publicada en maiproject.cl). Para
# regenerarlo tras cambiar una versión acá:
#
#   pip-compile --generate-hashes --strip-extras --output-file=requirements.txt requirements.in
#   pip-audit -r requirements.txt
#
# Versiones probadas y funcionando en este repo (ver commits de Fase 1).
#
# CSP: no se usa el paquete django-csp — Django 6.1 trae su propio
# middleware de Content-Security-Policy (ver config/settings.py).
Django==6.1.1
# python:3.13-slim (base del Dockerfile) no trae el paquete de sistema
# tzdata, y la imagen no instala nada por apt — sin esto, USE_TZ=True con
# TIME_ZONE="America/Santiago" fallaría al primer uso con
# ZoneInfoNotFoundError. Verificado en este repo simulando un contenedor
# sin tzdata del sistema (zoneinfo.reset_tzpath(to=())): con este paquete
# de pip, zoneinfo resuelve la zona igual.
tzdata==2026.5
gunicorn==26.2.0
